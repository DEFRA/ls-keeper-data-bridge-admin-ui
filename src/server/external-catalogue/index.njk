{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/file-upload/macro.njk" import govukFileUpload %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

{% block content %}
  {{ appHeading({
    text: heading
  }) }}

  {% if flash %}
    {{ govukNotificationBanner({
      type: flash.type,
      titleText: flash.title,
      text: flash.message
    }) }}
  {% endif %}

  {% if error %}
    <div class="govuk-error-summary" data-module="govuk-error-summary">
      <h2 class="govuk-error-summary__title">There is a problem</h2>
      <div class="govuk-error-summary__body">
        <p>{{ error }}</p>
      </div>
    </div>
  {% endif %}

  {% if apiError %}
    <div class="govuk-error-summary" data-module="govuk-error-summary">
      <h2 class="govuk-error-summary__title">There is a problem</h2>
      <div class="govuk-error-summary__body">
        <p>{{ apiError }}</p>
      </div>
    </div>
  {% endif %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <h2 class="govuk-heading-m">File catalogue report</h2>
      <p class="govuk-body">View available files for a source type within a date range.</p>

      <form method="post" action="/external-catalogue/files">
        {{ govukRadios({
          name: "sourceType",
          classes: "govuk-radios--inline",
          fieldset: {
            legend: { text: "Source type", classes: "govuk-fieldset__legend--s" }
          },
          items: [
            { value: "internal", text: "Internal", checked: formValues.sourceType === "internal" if formValues else false },
            { value: "external", text: "External", checked: formValues.sourceType === "external" if formValues else false }
          ]
        }) }}

        {{ govukInput({
          label: { text: "Days to look back", classes: "govuk-label--s" },
          hint: { text: "Number of days to include in the report" },
          id: "days",
          name: "days",
          value: formValues.days if formValues else "",
          inputmode: "numeric",
          classes: "govuk-input--width-5"
        }) }}

        {{ govukButton({
          text: "Get file report"
        }) }}
      </form>

      {% if filesReport %}
        <h3 class="govuk-heading-s">Report</h3>
        <pre class="govuk-body-s" style="overflow-x:auto;max-height:500px;background:#f3f2f1;padding:15px">{{ filesReport }}</pre>
      {% endif %}

      <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible">

      <h2 class="govuk-heading-m">Upload CSV file</h2>
      <p class="govuk-body">Upload a file to internal S3 storage. The filename must match a dataset definition pattern.</p>

      <form method="post" action="/external-catalogue/upload" enctype="multipart/form-data">
        {{ govukInput({
          label: { text: "Object key (filename)", classes: "govuk-label--s" },
          hint: { text: "Filename with no path separators" },
          id: "objectKey",
          name: "objectKey",
          classes: "govuk-input--width-20"
        }) }}

        {{ govukFileUpload({
          id: "file",
          name: "file",
          label: { text: "CSV file", classes: "govuk-label--s" },
          hint: { text: "Select a CSV file to upload" }
        }) }}

        {{ govukButton({
          text: "Upload file"
        }) }}
      </form>

    </div>
  </div>
{% endblock %}

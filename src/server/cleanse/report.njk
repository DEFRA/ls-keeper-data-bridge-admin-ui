{% extends 'layouts/page.njk' %}

{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}
  {{ appHeading({ text: heading }) }}

  {% if apiError %}
    <div class="govuk-error-summary" data-module="govuk-error-summary">
      <h2 class="govuk-error-summary__title">There is a problem</h2>
      <div class="govuk-error-summary__body">
        <p>{{ apiError }}</p>
      </div>
    </div>
  {% endif %}

  {% if run %}
    <p class="govuk-body govuk-!-margin-bottom-6">
      <a href="/cleanse/run/{{ run.id }}/report" class="govuk-link">Refresh this page</a>
    </p>

    {# ── Status tag ── #}
    {% if run.status === "Completed" %}
      {% set statusTag = govukTag({ text: run.status, classes: "govuk-tag--green" }) %}
    {% elif run.status === "Running" %}
      {% set statusTag = govukTag({ text: run.status, classes: "govuk-tag--blue" }) %}
    {% elif run.status === "Cancelling" %}
      {% set statusTag = govukTag({ text: "Cancelling…", classes: "govuk-tag--yellow" }) %}
    {% elif run.status === "Failed" %}
      {% set statusTag = govukTag({ text: run.status, classes: "govuk-tag--red" }) %}
    {% elif run.status === "Cancelled" %}
      {% set statusTag = govukTag({ text: run.status, classes: "govuk-tag--orange" }) %}
    {% else %}
      {% set statusTag = govukTag({ text: run.status or "Unknown", classes: "govuk-tag--grey" }) %}
    {% endif %}

    {# ═══════════════════════════════════════════════════════ #}
    {# Section 1 — Operation Summary                          #}
    {# ═══════════════════════════════════════════════════════ #}
    <h2 class="govuk-heading-m">Operation summary</h2>

    {{ govukSummaryList({
      rows: [
        {
          key: { text: "Operation ID" },
          value: { text: run.id }
        },
        {
          key: { text: "Status" },
          value: { html: statusTag }
        },
        {
          key: { text: "Description" },
          value: { text: run.statusDescription or "—" }
        },
        {
          key: { text: "Started" },
          value: { text: run.startedAtUtc | formatDate if run.startedAtUtc else "—" }
        },
        {
          key: { text: "Completed" },
          value: { text: run.completedAtUtc | formatDate if run.completedAtUtc else "—" }
        },
        {
          key: { text: "Duration" },
          value: { text: run.durationMs | formatDuration if run.durationMs else "—" }
        },
        {
          key: { text: "Current phase" },
          value: { text: currentPhase or "—" }
        },
        {
          key: { text: "Progress" },
          value: { text: (run.progressPercentage | round(1)) + "%" if run.progressPercentage is defined else "—" }
        },
        {
          key: { text: "Error" },
          value: { text: run.error or "—" }
        }
      ]
    }) }}

    {# ═══════════════════════════════════════════════════════ #}
    {# Section 2 — Record Counts                              #}
    {# ═══════════════════════════════════════════════════════ #}
    <h2 class="govuk-heading-m">Record counts</h2>

    {{ govukSummaryList({
      rows: [
        {
          key: { text: "Total records" },
          value: { text: run.totalRecords }
        },
        {
          key: { text: "Records analysed" },
          value: { text: run.recordsAnalyzed }
        },
        {
          key: { text: "Issues found" },
          value: { text: run.issuesFound }
        },
        {
          key: { text: "Issues resolved" },
          value: { text: run.issuesResolved }
        }
      ]
    }) }}

    {# ═══════════════════════════════════════════════════════ #}
    {# Section 3 — Performance Stats                          #}
    {# ═══════════════════════════════════════════════════════ #}
    {% if run.progress %}
      <h2 class="govuk-heading-m">Performance statistics</h2>

      {{ govukSummaryList({
        rows: [
          {
            key: { text: "Current RPM" },
            value: { text: (run.progress.currentRecordsPerMinute | round) + " records/min" if run.progress.currentRecordsPerMinute is defined else "—" }
          },
          {
            key: { text: "Average RPM" },
            value: { text: (run.progress.averageRecordsPerMinute | round) + " records/min" if run.progress.averageRecordsPerMinute is defined else "—" }
          },
          {
            key: { text: "Projected completion" },
            value: { text: run.progress.projectedEndTimeUtc | formatDate if run.progress.projectedEndTimeUtc else "—" }
          },
          {
            key: { text: "Time remaining" },
            value: { text: run.progress.projectedRemainingMs | formatDuration if run.progress.projectedRemainingMs is defined else "—" }
          },
          {
            key: { text: "Elapsed" },
            value: { text: run.progress.elapsed or "—" }
          }
        ]
      }) }}
    {% elif run.finalAverageRpm is defined and run.finalAverageRpm %}
      <h2 class="govuk-heading-m">Performance statistics</h2>

      {{ govukSummaryList({
        rows: [
          {
            key: { text: "Final average RPM" },
            value: { text: (run.finalAverageRpm | round) + " records/min" }
          }
        ]
      }) }}
    {% endif %}

    {# ═══════════════════════════════════════════════════════ #}
    {# Section 4 — Full Operation Tree                        #}
    {# ═══════════════════════════════════════════════════════ #}
    {% if operationTree and operationTree.length %}
      <h2 class="govuk-heading-m">Operation tree</h2>

      <div class="app-tree-toolbar govuk-!-margin-bottom-3">
        <button type="button" class="govuk-link app-tree-toolbar__btn" data-action="expand-all">Expand all</button>
        <span class="app-tree-toolbar__sep" aria-hidden="true">|</span>
        <button type="button" class="govuk-link app-tree-toolbar__btn" data-action="collapse-all">Collapse all</button>
      </div>

      {% for node in operationTree %}
        {# ── Status tag ── #}
        {% if node.status === "completed" %}
          {% set nodeTag = govukTag({ text: "Completed", classes: "govuk-tag--green" }) %}
        {% elif node.status === "in-progress" %}
          {% set nodeTag = govukTag({ text: "In progress", classes: "govuk-tag--blue" }) %}
        {% elif node.status === "not-started" %}
          {% set nodeTag = govukTag({ text: "Not started", classes: "govuk-tag--grey" }) %}
        {% elif node.status === "failed" %}
          {% set nodeTag = govukTag({ text: "Failed", classes: "govuk-tag--red" }) %}
        {% else %}
          {% set nodeTag = govukTag({ text: node.status or "—", classes: "govuk-tag--grey" }) %}
        {% endif %}

        <div class="app-tree-node app-tree-node--depth-{{ node.depth }}"
             data-depth="{{ node.depth }}"
             data-has-children="{{ 'true' if node.hasChildren else 'false' }}">
          <h3 class="govuk-heading-s govuk-!-margin-bottom-1 app-tree-node__heading">
            {{ node.name }}
            {{ nodeTag }}
          </h3>

          {% if node.description %}
            <p class="govuk-body-s govuk-!-margin-bottom-2 app-tree-node__description">{{ node.description }}</p>
          {% endif %}

          {# ── Progress bar for nodes with record counts ── #}
          {% if node.totalRecords and node.percentComplete != null %}
            <div class="app-progress-bar govuk-!-margin-bottom-2"
                 role="progressbar"
                 aria-valuenow="{{ node.percentComplete | round }}"
                 aria-valuemin="0"
                 aria-valuemax="100">
              <div class="app-progress-bar__fill" style="width: {{ node.percentComplete | round(1) }}%"></div>
            </div>
            <p class="govuk-body-s govuk-!-margin-bottom-2">
              {{ node.processedCount | default(0) | formatNumber }} / {{ node.totalRecords | formatNumber }} records ({{ node.percentComplete | round(1) }}%)
            </p>
          {% endif %}

          {% set nodeRows = [] %}

          {% if node.elapsed and node.elapsed !== "—" %}
            {% set nodeRows = (nodeRows.push({
              key: { text: "Elapsed" },
              value: { text: node.elapsed }
            }), nodeRows) %}
          {% endif %}

          {% if node.elapsedMs %}
            {% set nodeRows = (nodeRows.push({
              key: { text: "Duration" },
              value: { text: node.elapsedMs | formatDuration }
            }), nodeRows) %}
          {% endif %}

          {% if node.currentRpm != null %}
            {% set nodeRows = (nodeRows.push({
              key: { text: "Current RPM" },
              value: { text: (node.currentRpm | round) + " records/min" }
            }), nodeRows) %}
          {% endif %}

          {% if node.averageRpm != null %}
            {% set nodeRows = (nodeRows.push({
              key: { text: "Average RPM" },
              value: { text: (node.averageRpm | round) + " records/min" }
            }), nodeRows) %}
          {% endif %}

          {% if node.projectedEnd %}
            {% set nodeRows = (nodeRows.push({
              key: { text: "Projected completion" },
              value: { text: node.projectedEnd | formatDate }
            }), nodeRows) %}
          {% endif %}

          {% if node.projectedRemainingMs != null %}
            {% set nodeRows = (nodeRows.push({
              key: { text: "Time remaining" },
              value: { text: node.projectedRemainingMs | formatDuration }
            }), nodeRows) %}
          {% endif %}

          {% if nodeRows.length %}
            {{ govukSummaryList({ rows: nodeRows, classes: "govuk-summary-list--no-border" }) }}
          {% endif %}
        </div>
      {% endfor %}
    {% endif %}

    {# ═══════════════════════════════════════════════════════ #}
    {# Section 6 — Report Download                            #}
    {# ═══════════════════════════════════════════════════════ #}
    {% if run.reportUrl %}
      <h2 class="govuk-heading-m">Download report</h2>
      <p class="govuk-body">
        <a href="{{ run.reportUrl }}" class="govuk-link" target="_blank" rel="noopener noreferrer">Download report</a>
      </p>
      <form method="post" action="/cleanse/run/{{ run.id }}/regenerate-url">
        {{ govukButton({
          text: "Regenerate report URL",
          classes: "govuk-button--secondary"
        }) }}
      </form>
    {% elif run.reportObjectKey %}
      <h2 class="govuk-heading-m">Download report</h2>
      <p class="govuk-body">Report available but URL has expired.</p>
      <form method="post" action="/cleanse/run/{{ run.id }}/regenerate-url">
        {{ govukButton({
          text: "Regenerate report URL",
          classes: "govuk-button--secondary"
        }) }}
      </form>
    {% endif %}

    <p class="govuk-body govuk-!-margin-top-6">
      <a href="/cleanse" class="govuk-link">Back to dashboard</a>
    </p>
  {% endif %}
{% endblock %}

{% block pageScripts %}
  <script type="module" src="{{ getAssetPath('cleanse-report.js') }}"></script>
{% endblock %}

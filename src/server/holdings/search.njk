{% extends 'layouts/page.njk' %}

{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

{% block content %}
  {{ appHeading({
    text: heading
  }) }}

  {% if flash %}
    {{ govukNotificationBanner({
      type: flash.type,
      titleText: flash.title,
      text: flash.message
    }) }}
  {% endif %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <h2 class="govuk-heading-m">CTS CPH Holding</h2>
      <p class="govuk-body">Look up a CTS CPH holding by LID full identifier.</p>
      <form action="/holdings/cts" method="get" id="cts-form">
        {{ govukInput({
          label: { text: "LID full identifier", classes: "govuk-label--s" },
          hint: { text: "Format: XX-CC/PPP/HHHH (e.g. AB-12/345/6789)" },
          id: "lidFullIdentifier",
          name: "lidFullIdentifier",
          classes: "govuk-input--width-20"
        }) }}
        {{ govukButton({
          text: "Look up CTS holding"
        }) }}
      </form>

      <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible">

      <h2 class="govuk-heading-m">SAM CPH Holding</h2>
      <p class="govuk-body">Look up a SAM CPH holding by CPH value.</p>
      <form action="/holdings/sam" method="get" id="sam-form">
        {{ govukInput({
          label: { text: "CPH", classes: "govuk-label--s" },
          hint: { text: "Format: CC/PPP/HHHH (e.g. 12/345/6789)" },
          id: "cph",
          name: "cph",
          classes: "govuk-input--width-20"
        }) }}
        {{ govukButton({
          text: "Look up SAM holding"
        }) }}
      </form>

    </div>
  </div>
{% endblock %}
